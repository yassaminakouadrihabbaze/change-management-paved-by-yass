# next-azure-postgres — environment variables
# Copy to .env.local (gitignored). In Azure, these come from Key Vault via the app's managed identity,
# NOT from a committed file. Never commit real secrets.

# --- Database (Azure Database for PostgreSQL Flexible Server) ---
# Local dev can point at a local Postgres; Azure requires sslmode=require.
DATABASE_URL=postgresql://user:password@localhost:5432/appdb?sslmode=require

# --- Auth.js (NextAuth v5) session ---
# Generate with: npx auth secret
AUTH_SECRET=replace-me

# App base URL (used by Auth.js for callbacks)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Microsoft Entra ID provider (workforce / single tenant) ---
# From the Entra app registration. ISSUER must use your tenant id (not /common) to restrict sign-in.
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
